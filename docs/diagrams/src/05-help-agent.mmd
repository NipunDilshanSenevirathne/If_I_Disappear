  loop["<b>Muse Spark 1.3</b> · tool loop<br/>tool_choice auto · at most 4 turns"]:::meta
  t1["<b>search_steps</b>(query)<br/>code searches the recorded jobs"]:::code
  t2["<b>answer_with_task</b>(key, reason)"]:::meta
  t3["<b>not_recorded</b>(reason)"]:::meta
  fence{{"<b>The fence:</b> was that job<br/>in the search results?"}}:::code
  refuse["Refused"]:::bad
  ans["<b>Dilini's own recorded steps</b><br/>her words, her clip, who to call"]:::ok
