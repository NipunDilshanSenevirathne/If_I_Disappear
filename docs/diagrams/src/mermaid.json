    "actorMargin": 34,
    "messageMargin": 34,
    "boxMargin": 8,
    "noteMargin": 10,
    "useMaxWidth": false,
    "width": 128,
    "actorFontSize": 15,
    "noteFontSize": 15,
    "messageFontSize": 15,
    "actorFontFamily": "Segoe UI, Helvetica, Arial, sans-serif",
    "noteFontFamily": "Segoe UI, Helvetica, Arial, sans-serif",
    "messageFontFamily": "Segoe UI, Helvetica, Arial, sans-serif",
    "wrap": false
  }
}