{
  "theme": "base",
  "themeVariables": {
    "fontFamily": "Segoe UI, Helvetica, Arial, sans-serif",
    "fontSize": "15px",
    "primaryColor": "#ffffff",
    "primaryBorderColor": "#c3ced3",
    "primaryTextColor": "#13232b",
    "secondaryColor": "#e3ecf8",
    "tertiaryColor": "#f7f9fa",
    "lineColor": "#5e6f77",
    "textColor": "#13232b",
    "clusterBkg": "#f7f9fa",
    "clusterBorder": "#c3ced3",
    "titleColor": "#13232b",
    "edgeLabelBackground": "#ffffff",
    "noteBkgColor": "#fdf1da",
    "noteBorderColor": "#e99b1e",
    "noteTextColor": "#13232b",
    "actorBkg": "#e3ecf8",
    "actorBorder": "#285890",
    "actorTextColor": "#13232b",
    "actorLineColor": "#c3ced3",
    "signalColor": "#44565f",
    "signalTextColor": "#13232b",
    "labelBoxBkgColor": "#fdf1da",
    "labelBoxBorderColor": "#e99b1e",
    "loopTextColor": "#13232b",
    "activationBkgColor": "#fdf1da",
    "activationBorderColor": "#e99b1e",
    "sequenceNumberColor": "#ffffff"
