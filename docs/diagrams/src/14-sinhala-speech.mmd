  unc["<b>Unclear</b> · never read into a fact<br/>listed on the review page, so the<br/>owner can say it again"]:::warn
  meas[("<b>Measured</b> on 189 public Sinhala clips, 12 speakers<br/>12.4% character error rate · 3.2× real time on 2 CPUs")]:::store

