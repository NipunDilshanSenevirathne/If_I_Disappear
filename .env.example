# Copy to .env and fill in. Never commit .env. Without MODEL_API_KEY the app runs in judge mode
# (the sample home, replayed model outputs, every check live).

# Meta Model API (Muse Spark 1.3, SAM 3.1, Muse Voice Transcribe, Muse Wonder)
MODEL_API_KEY=
IID_MODE=live
IID_DAILY_BUDGET_USD=5
# Optional lifetime cap and where the running total is kept
IID_TOTAL_BUDGET_USD=
IID_SPEND_FILE=

# Development only: Muse Spark Open on Fireworks instead of Meta's API (no SAM 3.1 or speech there)
# MODEL_PROVIDER=fireworks
# FIREWORKS_API_KEY=

# Sinhala speech (services/sinhala-asr)
SINHALA_ASR_URL=
SINHALA_ASR_TOKEN=

# Signs every link and QR sticker. Empty: one is made once and kept in the data folder.
IID_LINK_SECRET=

# Where the app is reachable, for WhatsApp links. QR codes use it too; if it's empty they use the
# address the owner is using.
IID_PUBLIC_BASE_URL=
# Who may show the app in a frame. Empty: nobody. A Hugging Face Space: https://huggingface.co
IID_FRAME_ANCESTORS=
# New real households are invite-only unless this is on. IID_ADMIN_TOKEN is the invite code the
# Start page (/start) asks for, and the X-Admin-Token the live check sends.
IID_ALLOW_PUBLIC_LIVE=false
IID_ADMIN_TOKEN=
# Recordings go up in pieces: the most in all, and the size of each piece
IID_MAX_UPLOAD_MB=1024
IID_UPLOAD_CHUNK_KB=8192

# WhatsApp Cloud API (test number), optional
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_GRAPH_VERSION=v21.0
